# Qdrant vector database connection
QDRANT_URL=

# Gemini & Groq API key
GOOGLE_API_KEY=
GROQ_API_KEY=

# Service token - must match the one in Node.js backend
SERVICE_TOKEN=

# Embedding model settings
EMBEDDING_MODEL=
EMBEDDING_DIM=

LLM_MODEL=
LLM_TEMPERATURE=

# Langsmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Guardrails (V0) - toggle the guard nodes and set the output ban list
GUARD_INPUT_ENABLED=true
GUARD_OUTPUT_ENABLED=true
GUARD_BANNED_WORDS=athena,codename-omega,sk-example